#!/usr/bin/env python3
import argparse
import json
import os
import subprocess
import sys
try:
    import argcomplete # pyright: ignore[reportMissingImports]
except ImportError:
    argcomplete = None

def check_dependency(command: str):
    result = subprocess.run(["which", command], capture_output=True)
    if result.returncode != 0:
        print(f"Error: {command} is not installed", file=sys.stderr)
        sys.exit(1)

KEEP_ENV_DEFAULT = ["TERM", "SHELL", "COLORTERM"]

class color:
    GRAY = "\033[90m"
    RESET = "\033[0m"

cri = {}
cache_pods = {}
cache_containers = {}

def fetch_cri_data():
    check_dependency("crictl")

    global cri
    result = subprocess.run(["crictl", "inspect", "--state", "running", "-o", "json"], capture_output=True, text=True)
    if result.returncode != 0:
        print("Error: Failed to fetch CRI data", file=sys.stderr)
        sys.exit(1)
    cri = json.loads(result.stdout)

def _get_pods_for_namespace(namespace: str) -> set[str]:
    if namespace in cache_pods:
        return cache_pods[namespace]

    pods = { container["info"]["config"]["labels"]["io.kubernetes.pod.name"]
             for container in cri
             if container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] == namespace }
    cache_pods[namespace] = pods
    return pods

def _get_containers_for_pod(namespace: str, pod: str) -> set[str]:
    key = (namespace, pod)
    if key in cache_containers:
        return cache_containers[key]

    containers = { container["info"]["config"]["labels"]["io.kubernetes.container.name"]
                   for container in cri
                   if container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] == namespace
                   and container["info"]["config"]["labels"]["io.kubernetes.pod.name"] == pod }
    cache_containers[key] = containers
    return containers

class PodCompleter:
    def __call__(self, prefix: str, parsed_args: argparse.Namespace, **kwargs) -> list[str]:
        if not getattr(parsed_args, 'namespace', None):
            return []
        pods = _get_pods_for_namespace(parsed_args.namespace)
        return [pod for pod in pods if pod.startswith(prefix)]

class ContainerCompleter:
    def __call__(self, prefix: str, parsed_args: argparse.Namespace, **kwargs) -> list[str]:
        if not getattr(parsed_args, 'namespace', None) or not getattr(parsed_args, 'pod', None):
            return []
        containers = _get_containers_for_pod(parsed_args.namespace, parsed_args.pod)
        return [container for container in containers if container.startswith(prefix)]


def no_fail_parse_known_args(parser: argparse.ArgumentParser, argv: list[str]) -> argparse.Namespace:
    """Parse known arguments without failing on required arguments."""
    required_actions = [
        actions for actions in parser._actions if actions.required
    ]
    for action in required_actions:
        action.required = False

    args = parser.parse_known_args(argv)[0]

    for action in required_actions:
        action.required = True

    return args


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="jump into a container's namespace")
    parser.add_argument('--keep-env', action='append', default=KEEP_ENV_DEFAULT, help='Environment variables to keep')

    # for initialisation processing we need process only the arguments before "--" without -h/--help
    argv = sys.argv[1:]
    if "--" in argv:
        argv = argv[:argv.index("--")]
    argv = [arg for arg in argv if arg not in ('-h', '--help')]

    fetch_cri_data()
    namespaces = { container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] for container in cri }
    container_group = parser.add_argument_group("Container", "Specify the container to enter")
    container_group.add_argument("namespace", choices=sorted(namespaces), type=str,
                                 help="Namespace of the container")

    args = no_fail_parse_known_args(parser, argv)
    ns = getattr(args, 'namespace', None)
    kargs = {"choices": _get_pods_for_namespace(ns)} if ns else {}
    container_group.add_argument("pod", type=str,
                                 **kargs, help="Pod name") \
        .completer = PodCompleter()

    args = no_fail_parse_known_args(parser, argv)
    pod = getattr(args, 'pod', None)
    kargs = {}
    if ns and pod:
        kargs["choices"] = _get_containers_for_pod(ns, pod)
        if len(kargs["choices"]) == 1:
            kargs["nargs"] = "?"
            kargs["default"] = list(kargs["choices"])[0]
    container_group.add_argument("container", type=str,
                                 **kargs, help="Container name in pod") \
        .completer = ContainerCompleter()

    nsenter_group = parser.add_argument_group("Nsenter", "args for nsenter to use")
    nsenter_group.add_argument("--mount", action="store_true",
                               help="Enter the mount namespace")
    nsenter_group.add_argument("--no-uts", action="store_true",
                               help="Do not enter the UTS namespace")
    nsenter_group.add_argument("--ipc", action="store_true",
                               help="Enter the IPC namespace")
    nsenter_group.add_argument("--no-net", action="store_true",
                               help="Do not enter the network namespace")
    nsenter_group.add_argument("--pid", action="store_true",
                               help="Enter the PID namespace")
    nsenter_group.add_argument("--no-set-root", action="store_true",
                               help="Do not change into the root directory of the target namespace")

    args = no_fail_parse_known_args(parser, argv)
    if (ns and pod and getattr(args, "container", None)) or help:
        parser.add_argument("command", nargs="*", default=[os.environ.get("SHELL", "/bin/bash")],
                            help="Command to execute inside the container, if not specified, defaults to an interactive shell")

    if argcomplete:
        argcomplete.autocomplete(parser)

    return parser.parse_args()

def fetch_container_data(args: argparse.Namespace) -> dict:
    return next(
        (container for container in cri
         if container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] == args.namespace
         and container["info"]["config"]["labels"]["io.kubernetes.pod.name"] == args.pod
         and container["info"]["config"]["labels"]["io.kubernetes.container.name"] == args.container),
        None
    )

def main():
    args = parse_args()

    # fetch container data from cri based on args
    container_data = fetch_container_data(args)
    if container_data is None:
        print("Error: Container not found, this should not happen", file=sys.stderr)
        sys.exit(1)

    # set env from containter_data["info"]["config"]["envs"]: (e.g. content [{"key":"foo", "value": "bar"}])
    env = { item["key"]: item["value"] for item in container_data["info"]["config"]["envs"] }
    print(f"Initial environment with {len(env)} variables")
    for e in args.keep_env:
        if e in os.environ:
            env[e] = os.environ[e]
    if args.command and "zsh" in args.command[0]:
        env["debian_chroot"] = "debug" # I don't want to set the entire prompt manually
    else:
        env["PS1"] = f"(debug) {os.environ.get('PS1', '\\u@\\h \\w \\$ ')}"

    # list mount points from container_data["info"]["config"]["mounts"]
    mounts = { f"{f'  (ro) {color.GRAY}' if item.get('readonly') else '       '}{item['container_path'][1:]}{color.RESET}" for item in container_data["info"]["config"]["mounts"] }
    pid = container_data["info"]["pid"]
    print(f"Mount points:\n{'\n'.join(sorted(mounts))}")

    # open shell using nsenter with the environment variables set
    nsenter = ["nsenter", "--target", str(pid)]
    if args.mount:
        nsenter.append("--mount")
    if not args.no_uts:
        nsenter.append("--uts")
    if args.ipc:
        nsenter.append("--ipc")
    if not args.no_net:
        nsenter.append("--net")
    if args.pid:
        nsenter.append("--pid")
    if not args.no_set_root:
        nsenter.append(f"--wd=/proc/{pid}/root")
        env["PWD"] = f"/proc/{pid}/root"

    print(f"Entering container {args.namespace}/{args.pod}/{args.container} with PID {pid}; ID {container_data['status']['id']}")
    os.execvpe(nsenter[0], nsenter + args.command, env)

if __name__ == "__main__":
    main()

