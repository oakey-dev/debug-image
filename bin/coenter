#!/usr/bin/env python3
import argparse
import json
import logging
import os
import subprocess
import sys
from shutil import which
try:
    import argcomplete # pyright: ignore[reportMissingImports]
except ImportError:
    argcomplete = None

logger = logging.getLogger(__name__)

def check_dependency(command: str):
    if which(command) is None:
        logger.error(f"{command} is not installed")
        sys.exit(1)

KEEP_ENV_DEFAULT = ["TERM", "SHELL", "COLORTERM"]

class color:
    GRAY = "\033[90m"
    RESET = "\033[0m"

containers = {}

def fetch_podman_data():
    check_dependency("podman")

    result = subprocess.run(["podman", "ps", "--format", "json"], capture_output=True, text=True)
    if result.returncode != 0:
        logger.error("Failed to fetch Podman data")
        logger.error(result.stderr)
        sys.exit(1)
    podman = json.loads(result.stdout)
    global containers
    containers = { (None, None, name): False for container in podman for name in container["Names"] }

def fetch_docker_data():
    check_dependency("docker")

    result = subprocess.run(["docker", "ps", "--format", "{{json .}}"], capture_output=True, text=True)
    if result.returncode != 0:
        logger.error("Failed to fetch Docker data")
        logger.error(result.stderr)
        sys.exit(1)
    docker_containers = [json.loads(line) for line in result.stdout.splitlines()]
    global containers
    containers = { (None, None, container["Names"]): False for container in docker_containers }

def parse_env(env_list: list[str]) -> dict[str, str]:
    env = []
    for item in env_list:
        if "=" in item:
            key, value = item.split("=", 1)
            env.append({"key": key, "value": value})
    return env

def parse_mounts(mount_list: list[dict]) -> list[dict]:
    return [ {"container_path": mount["Destination"],
              "readonly": not mount["RW"]}
                for mount in mount_list ]

def fetch_docker_container(name: str):
    result = subprocess.run(["docker", "inspect", "--format", "json", name], capture_output=True, text=True)
    if result.returncode != 0:
        logger.error(f"Failed to fetch Docker container data for {name}")
        logger.error(result.stderr)
        sys.exit(1)
    data = json.loads(result.stdout)[0]
    return {
        "id": data["Id"],
        "pid": data["State"]["Pid"],
        "env": parse_env(data["Config"]["Env"]),
        "mount": parse_mounts(data["Mounts"]),
    }

def fetch_podman_container(name: str):
    result = subprocess.run(["podman", "inspect", "--format", "json", name], capture_output=True, text=True)
    if result.returncode != 0:
        logger.error(f"Failed to fetch Podman container data for {name}")
        logger.error(result.stderr)
        sys.exit(1)
    data = json.loads(result.stdout)[0]
    return {
        "id": data["Id"],
        "pid": data["State"]["Pid"],
        "env": parse_env(data["Config"]["Env"]),
        "mount": parse_mounts(data["Mounts"]),
    }

def extract_cri_data(container: dict) -> dict:
    return {
        "id": container["status"]["id"],
        "pid": container["info"]["pid"],
        "env": container["info"]["config"]["envs"],
        "mount": container["info"]["config"]["mounts"],
        "namespace": container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"],
        "pod": container["info"]["config"]["labels"]["io.kubernetes.pod.name"],
        "container": container["info"]["config"]["labels"]["io.kubernetes.container.name"],
    }

def fetch_cri_data():
    check_dependency("crictl")

    result = subprocess.run(["crictl", "inspect", "--state", "running", "-o", "json"], capture_output=True, text=True)
    if result.returncode != 0:
        logger.error("Failed to fetch CRI data")
        logger.error(result.stderr)
        sys.exit(1)
    cri = json.loads(result.stdout)
    global containers
    containers = {
        (container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"],
         container["info"]["config"]["labels"]["io.kubernetes.pod.name"],
         container["info"]["config"]["labels"]["io.kubernetes.container.name"]): extract_cri_data(container)
                   for container in cri }

def _get_pods_for_namespace(namespace: str) -> set[str]:
    return { pod for ns, pod, _ in containers.keys() if ns == namespace }

def _get_containers_for_pod(namespace: str, pod: str) -> set[str]:
    return { name for ns, p, name in containers.keys() if ns == namespace and p == pod }

class PodCompleter:
    def __call__(self, prefix: str, parsed_args: argparse.Namespace, **kwargs) -> list[str]:
        if not getattr(parsed_args, 'namespace', None):
            return []
        pods = _get_pods_for_namespace(parsed_args.namespace)
        return [pod for pod in pods if pod.startswith(prefix)]

class ContainerCompleter:
    def __call__(self, prefix: str, parsed_args: argparse.Namespace, **kwargs) -> list[str]:
        containers = _get_containers_for_pod(parsed_args.namespace, parsed_args.pod)
        return [container for container in containers if container.startswith(prefix)]


def no_fail_parse_known_args(parser: argparse.ArgumentParser, argv: list[str]) -> argparse.Namespace:
    """Parse known arguments without failing on required arguments."""
    required_actions = [
        actions for actions in parser._actions if actions.required
    ]
    for action in required_actions:
        action.required = False

    args = parser.parse_known_args(argv)[0]

    for action in required_actions:
        action.required = True

    return args


def parse_args() -> argparse.Namespace:
    parser = argparse.ArgumentParser(description="jump into a container's namespace")
    parser.add_argument('--keep-env', action='append', default=KEEP_ENV_DEFAULT, help='Environment variables to keep')
    cr = parser.add_argument('--container-runtime', choices=['k8s', 'docker', 'podman'], default=os.environ.get('CONTAINER_RUNTIME'),
                        help='Specify the container runtime to use (default: autodetect)')
    exclusive_group = parser.add_mutually_exclusive_group()
    exclusive_group.add_argument('--debug', '-d', action='store_true', help='Enable debug mode')
    exclusive_group.add_argument('--quiet', '-q', action='store_true', help='Disable all non error output from this script')

    # for initialisation processing we need process only the arguments before "--" without -h/--help
    argv = sys.argv[1:]
    if "--" in argv:
        argv = argv[:argv.index("--")]
    argv = [arg for arg in argv if arg not in ('-h', '--help')]

    args = no_fail_parse_known_args(parser, argv)
    # Initialize logging based on --debug and --quiet flags
    level = logging.INFO
    if args.quiet:
        level = logging.ERROR
    elif args.debug:
        level = logging.DEBUG
    logging.basicConfig(level=level, format='%(levelname)s: %(message)s')

    if args.container_runtime is None:
        logging.debug("Autodetecting container runtime...")
        if which("crictl") is not None:
            cr.default = "k8s"
            args.container_runtime = "k8s"
        elif which("podman") is not None:
            cr.default = "podman"
            args.container_runtime = "podman"
        elif which("docker") is not None:
            cr.default = "docker"
            args.container_runtime = "docker"
        else:
            logging.error("No suitable container runtime found")
            sys.exit(1)

    container_group = parser.add_argument_group("Container", "Specify the container to enter")
    ns = True
    pod = True
    if args.container_runtime == "k8s":
        fetch_cri_data()
        namespaces = { container["namespace"] for container in containers.values() }
        container_group.add_argument("namespace", choices=sorted(namespaces), type=str,
                                    help="Namespace of the container")

        args = no_fail_parse_known_args(parser, argv)
        ns = getattr(args, 'namespace', None)
        kargs = {"choices": _get_pods_for_namespace(ns)} if ns else {}
        container_group.add_argument("pod", type=str,
                                    **kargs, help="Pod name") \
            .completer = PodCompleter()

        args = no_fail_parse_known_args(parser, argv)
        pod = getattr(args, 'pod', None)
        kargs = {}
        if ns and pod:
            kargs["choices"] = _get_containers_for_pod(ns, pod)
            if len(kargs["choices"]) == 1:
                kargs["nargs"] = "?"
                kargs["default"] = list(kargs["choices"])[0]
        container_group.add_argument("container", type=str,
                                    **kargs, help="Container name in pod") \
            .completer = ContainerCompleter()
    else:
        if args.container_runtime == "podman":
            fetch_podman_data()
        else:
            fetch_docker_data()

        container_group.add_argument("--namespace", required=False, default=None, help=argparse.SUPPRESS)
        container_group.add_argument("--pod", required=False, default=None, help=argparse.SUPPRESS)
        container_group.add_argument("container", type=str, choices=_get_containers_for_pod(None, None),
                                    help="Container name") \
            .completer = ContainerCompleter()

    nsenter_group = parser.add_argument_group("Nsenter", "args for nsenter to use")
    nsenter_group.add_argument("--mount", action="store_true",
                               help="Enter the mount namespace")
    nsenter_group.add_argument("--no-uts", action="store_true",
                               help="Do not enter the UTS namespace")
    nsenter_group.add_argument("--ipc", action="store_true",
                               help="Enter the IPC namespace")
    nsenter_group.add_argument("--no-net", action="store_true",
                               help="Do not enter the network namespace")
    nsenter_group.add_argument("--pid", action="store_true",
                               help="Enter the PID namespace")
    nsenter_group.add_argument("--no-set-root", action="store_true",
                               help="Do not change into the root directory of the target namespace")

    args = no_fail_parse_known_args(parser, argv)
    if (ns and pod and getattr(args, "container", None)) or help:
        parser.add_argument("command", nargs="*", default=[os.environ.get("SHELL", "/bin/bash")],
                            help="Command to execute inside the container, if not specified, defaults to an interactive shell")

    if argcomplete:
        argcomplete.autocomplete(parser)

    return parser.parse_args()


def main():
    args = parse_args()

    name = args.container
    if args.container_runtime == "k8s":
        name = f"{args.namespace}/{args.pod}/{args.container}"
        container_data = containers.get((args.namespace, args.pod, args.container))
        if container_data is None:
            logger.error("Container not found, this should not happen")
            sys.exit(1)
    elif args.container_runtime == "podman":
        container_data = fetch_podman_container(args.container)
    elif args.container_runtime == "docker":
        container_data = fetch_docker_container(args.container)
    else:
        logger.error(f"Unsupported container runtime: {args.container_runtime}")
        sys.exit(1)

    # set env from containter_data["env"]: (e.g. content [{"key":"foo", "value": "bar"}])
    env = { item["key"]: item["value"] for item in container_data["env"] }
    logger.info(f"Initial environment with {len(env)} variables")
    logger.debug(f"Environment variables injected from container: {' '.join(env.keys())}")
    for e in args.keep_env:
        if e in os.environ:
            env[e] = os.environ[e]
    if args.command and "zsh" in args.command[0]:
        env["debian_chroot"] = "debug" # I don't want to set the entire prompt manually
    else:
        env["PS1"] = f"(debug) {os.environ.get('PS1', '\\u@\\h \\w \\$ ')}"

    # list mount points from container_data["mount"]
    mounts = { f"{f'  (ro) {color.GRAY}' if item.get('readonly') else '       '}{item['container_path'][1:]}{color.RESET}"
              for item in container_data["mount"] }
    pid = container_data["pid"]
    logger.info(f"Mount points:\n{'\n'.join(sorted(mounts))}")

    # open shell using nsenter with the environment variables set
    nsenter = ["nsenter", "--target", str(pid)]
    if args.mount:
        nsenter.append("--mount")
    if not args.no_uts:
        nsenter.append("--uts")
    if args.ipc:
        nsenter.append("--ipc")
    if not args.no_net:
        nsenter.append("--net")
    if args.pid:
        nsenter.append("--pid")
    if not args.no_set_root:
        nsenter.append(f"--wd=/proc/{pid}/root")
        env["PWD"] = f"/proc/{pid}/root"

    logger.info(f"Entering container {name} with PID {pid}; ID {container_data['id']}")
    logger.debug(f"NSEnter command used (without env): {' '.join(nsenter + args.command)}")
    os.execvpe(nsenter[0], nsenter + args.command, env)

if __name__ == "__main__":
    main()

