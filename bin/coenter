#!/usr/bin/env python3
import argparse
import json
from operator import add, ge
import os
import subprocess
import sys
try:
    import argcomplete # pyright: ignore[reportMissingImports]
except ImportError:
    argcomplete = None

def check_dependency(command: str):
    result = subprocess.run(["which", command], capture_output=True)
    if result.returncode != 0:
        print(f"Error: {command} is not installed", file=sys.stderr)
        sys.exit(1)

KEEP_ENV_DEFAULT = ["TERM", "SHELL", "COLORTERM"]

class color:
    GRAY = "\033[90m"
    RESET = "\033[0m"

cri = {}
cache_pods = {}
cache_containers = {}

def _get_pods_for_namespace(namespace: str) -> set[str]:
    if namespace in cache_pods:
        return cache_pods[namespace]

    pods = { container["info"]["config"]["labels"]["io.kubernetes.pod.name"]
             for container in cri
             if container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] == namespace }
    cache_pods[namespace] = pods
    return pods

def _get_containers_for_pod(namespace: str, pod: str) -> set[str]:
    key = (namespace, pod)
    if key in cache_containers:
        return cache_containers[key]

    containers = { container["info"]["config"]["labels"]["io.kubernetes.container.name"]
                   for container in cri
                   if container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] == namespace
                   and container["info"]["config"]["labels"]["io.kubernetes.pod.name"] == pod }
    cache_containers[key] = containers
    return containers

class PodCompleter:
    def __call__(self, prefix: str, parsed_args: argparse.Namespace, **kwargs) -> list[str]:
        if not hasattr(parsed_args, 'namespace') or parsed_args.namespace is None:
            return []
        pods = _get_pods_for_namespace(parsed_args.namespace)
        return [pod for pod in pods if pod.startswith(prefix)]

class ContainerCompleter:
    def __call__(self, prefix: str, parsed_args: argparse.Namespace, **kwargs) -> list[str]:
        if not hasattr(parsed_args, 'namespace') or parsed_args.namespace is None:
            return []
        if not hasattr(parsed_args, 'pod') or parsed_args.pod is None:
            return []
        containers = _get_containers_for_pod(parsed_args.namespace, parsed_args.pod)
        return [container for container in containers if container.startswith(prefix)]

class PodAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        ns = getattr(namespace, 'namespace', None)
        if ns is None:
            raise argparse.ArgumentError(self, f"Namespace must be specified before pod")
        pods = _get_pods_for_namespace(ns)
        self.choices = pods
        if values not in pods:
            raise argparse.ArgumentError(self, f"Invalid pod '{values}' for namespace '{ns}'. Valid pods: {', '.join(sorted(pods))}")
        setattr(namespace, self.dest, values)

class ContainerAction(argparse.Action):
    def __call__(self, parser, namespace, values, option_string=None):
        ns = getattr(namespace, 'namespace', None)
        pod = getattr(namespace, 'pod', None)
        if ns is None:
            raise argparse.ArgumentError(self, f"Namespace must be specified before container")
        if pod is None:
            raise argparse.ArgumentError(self, f"Pod must be specified before container")
        containers = _get_containers_for_pod(ns, pod)
        self.choices = containers
        if values not in containers:
            raise argparse.ArgumentError(self, f"Invalid container '{values}' for pod '{pod}'. Valid containers: {', '.join(sorted(containers))}")
        setattr(namespace, self.dest, values)

def parse_args() -> argparse.Namespace:
    namespaces = { container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] for container in cri }

    parser = argparse.ArgumentParser(description="jump into a container's namespace", add_help=False)

    parser.add_argument('-h', '--help', action='store_true', help='Show the help message and exit', dest='help_requested')
    parser.add_argument('--keep-env', action='append', default=KEEP_ENV_DEFAULT, help='Environment variables to keep')

    container_group = parser.add_argument_group("Container", "Specify the container to enter")

    args = parser.parse_known_args()[0]

    argcomp = os.environ.get("_ARGCOMPLETE", False) == "1"
    help = args.help_requested or argcomp
    kargs = {} if not help else {"nargs": "?"}
    ns = container_group.add_argument("namespace", choices=sorted(namespaces), type=str,
                                      **kargs, help="Namespace of the containers")


    #kargs = {"action": PodAction}
    ##if not argco:
    ##    args = parser.parse_known_args()[0]
    ##    if args.namespace:
    ##        kargs = {"choices": _get_pods_for_namespace(args.namespace)}
    #pod_arg = container_group.add_argument("pod", **kargs,
    #                                       help="Pod of the containers")
    args = parser.parse_known_args()[0]
    po = None
    if args.namespace or argcomp:
        if ns.nargs:
            ns.nargs=None
        kargs = {} if not help else {"nargs": "?"}
        if not argcomp:
            kargs["choices"] = _get_pods_for_namespace(args.namespace)
        po = container_group.add_argument("pod", type=str,
                                          **kargs, help="Pod of the containers")

    args = parser.parse_known_args()[0]
    co = None
    if (args.namespace and getattr(args, 'pod', None)) or argcomp:
        if po.nargs:
            po.nargs=None
        kargs = {} if not help else {"nargs": "?"}
        if not argcomp:
            kargs["choices"] = _get_containers_for_pod(args.namespace, args.pod)
            if len(kargs["choices"]) == 1:
                kargs["nargs"] = "?"
                kargs["default"] = list(kargs["choices"])[0]
        co = container_group.add_argument("container", type=str,
                                          **kargs, help="Container name")

    #kargs = {"action": ContainerAction}
    ##if not argco:
    ##    args = parser.parse_known_args()[0]
    ##    if args.namespace and args.pod:
    ##        kargs = {"choices": _get_containers_for_pod(args.namespace, args.pod)}
    #container_arg = container_group.add_argument("container", **kargs,
    #                                              help="Container name")

    nsenter_group = parser.add_argument_group("Nsenter", "args for nsenter to use")
    nsenter_group.add_argument("--mount", action="store_true",
                               help="Enter the mount namespace")
    nsenter_group.add_argument("--no-uts", action="store_true",
                               help="Enter the UTS namespace")
    nsenter_group.add_argument("--ipc", action="store_true",
                               help="Enter the IPC namespace")
    nsenter_group.add_argument("--no-net", action="store_true",
                               help="Enter the network namespace")
    nsenter_group.add_argument("--pid", action="store_true",
                               help="Enter the PID namespace")
    nsenter_group.add_argument("--no-set-root", action="store_true",
                               help="cd into the root directory of the target namespace")

    args = parser.parse_known_args()[0]
    if getattr(args, "namespace", None) and getattr(args, "pod", None) and getattr(args, "container", None):
        parser.add_argument("command", nargs="*", default=[os.environ.get("SHELL", "/bin/bash")],
                            help="Command to execute inside the container, if not specified, defaults to an interactive shell")

    if argcomplete:
        if po:
            po.action = PodAction
            po.completer = PodCompleter()
        if co:
            co.action = ContainerAction
            co.completer = ContainerCompleter()
        argcomplete.autocomplete(parser)

    args = parser.parse_args()
    if args.help_requested:
        #pod_arg.choices = _get_pods_for_namespace(args.namespace)
        #if args.pod:
        #    container_arg.choices = _get_containers_for_pod(args.namespace, args.pod)
        #    container_arg.nargs = "?"
        #else:
        #    pod_arg.nargs = "?"
        #    container_arg.nargs = "?"
        parser.print_help()
        sys.exit(0)

    return args

def fetch_container_data(args: argparse.Namespace) -> dict:
    return next(
        (container for container in cri
         if container["info"]["config"]["labels"]["io.kubernetes.pod.namespace"] == args.namespace
         and container["info"]["config"]["labels"]["io.kubernetes.pod.name"] == args.pod
         and container["info"]["config"]["labels"]["io.kubernetes.container.name"] == args.container),
        None
    )

def main():
    check_dependency("crictl")

    global cri
    cri = json.loads(subprocess.run(["crictl", "inspect", "-a", "--state", "running", "-o", "json"], capture_output=True, text=True).stdout)
    args = parse_args()

    # fetch container data from cri based on args
    container_data = fetch_container_data(args)
    if container_data is None:
        print("Error: Container not found", file=sys.stderr)
        sys.exit(1)

    # set env from containter_data["info"]["config"]["envs"]: (e.g. content [{"key":"foo", "value": "bar"}])
    env = { item["key"]: item["value"] for item in container_data["info"]["config"]["envs"] }
    for e in args.keep_env:
        if e in os.environ:
            env[e] = os.environ[e]
    if args.command and "zsh" in args.command[0]:
        env["debian_chroot"] = "debug" # I don't want to set the entire prompt manually
    else:
        env["PS1"] = f"(debug) {os.environ.get('PS1', '\\u@\\h \\w \\$ ')}"

    # list mount points from container_data["info"]["config"]["mounts"]
    mounts = { f"{f'  (ro) {color.GRAY}' if item.get('readonly') else '       '}{item['container_path']}{color.RESET}" for item in container_data["info"]["config"]["mounts"] }
    pid = container_data["info"]["pid"]
    print(f"Entering container {args.namespace}/{args.pod}/{args.container} with PID {pid}; ID {container_data['status']['id']}")
    print(f"Mount points:\n{'\n'.join(sorted(mounts))}")

    # open shell using nsenter with the environment variables set
    nsenter = ["nsenter", "--target", str(pid)]
    if args.mount:
        nsenter.append("--mount")
    if not args.no_uts:
        nsenter.append("--uts")
    if args.ipc:
        nsenter.append("--ipc")
    if not args.no_net:
        nsenter.append("--net")
    if args.pid:
        nsenter.append("--pid")
    if not args.no_set_root:
        nsenter.append(f"--wd=/proc/{pid}/root")
        env["PWD"] = f"/proc/{pid}/root"
    #print(f"Executing command: {' '.join(nsenter + args.command)}")
    os.execvpe(nsenter[0], nsenter + args.command, env)

if __name__ == "__main__":
    main()

