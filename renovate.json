{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "abandonmentThreshold": "2 years",
  "packageRules": [
    {
      "matchDatasources": ["apk"],
      "separateMultipleMajor": false,
      "groupName": "packages",
      "commitBodyTable": true,
      "registryUrls": [
        "https://dl-cdn.alpinelinux.org/alpine?branch=v3.24&components=main,community&arch=x86_64"
      ]
    },
    {
      "matchDatasources": ["docker"],
      "separateMultipleMinor": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchDatasources": ["docker"],
      "separateMultipleMinor": true,
      "pinDigests": true
    },
    {
      "matchManagers": ["dockerfile"],
      "matchUpdateTypes": ["patch", "digest"],
      "matchDatasources": ["docker"],
      "groupName": "packages",
      "pinDigests": true
    }
  ],
  "customManagers": [
    {
      "customType": "regex",
      "description": "Update Alpine registry URL branch",
      "fileMatch": ["^renovate\\.json$"],
      "matchStrings": [
        "\"registryUrls\"\\s*:\\s*\\[\\s*\"https://dl-cdn\\.alpinelinux\\.org/alpine\\?branch=v(?<currentValue>\\d+\\.\\d+)&components=main,community&arch=x86_64\""
      ],
      "currentValueTemplate": "{{{currentValue}}}",
      "datasourceTemplate": "docker",
      "depNameTemplate": "alpine",
      "versioningTemplate": "regex:^(?<major>\\d+)\\.(?<minor>\\d+)$",
      "autoReplaceStringTemplate": "\"registryUrls\": [\n        \"https://dl-cdn.alpinelinux.org/alpine?branch=v{{{newMajor}}}.{{{newMinor}}}&components=main,community&arch=x86_64\""
    }
  ],
  "maxMajorIncrement": 0,
  "osvVulnerabilityAlerts": true,
  "separateMultipleMajor": true,
  "prConcurrentLimit": 10,
  "prHourlyLimit": 10,
  "reviewersFromCodeOwners": true
}
